# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key from console.anthropic.com (product identification and listing writing)
ANTHROPIC_API_KEY=

# Optional: paid UPCitemdb key. Without it the free trial tier (about 100 lookups a day) is used.
UPCITEMDB_KEY=
